+  // RENASER (patches/expo-camera): factor del lente normal. Solo si la camara
+  // virtual incluye el ultra gran angular su primer cambio de lente es el paso
+  // al normal; en la doble (normal + tele) el 1.0 ya es el normal.
+  private static func zoomNeutro(_ device: AVCaptureDevice) -> CGFloat {
+    guard device.isVirtualDevice,
+          device.constituentDevices.contains(where: { $0.deviceType == .builtInUltraWideCamera }),
+          let cambio = device.virtualDeviceSwitchOverVideoZoomFactors.first else {
+      return 1.0
+    }
+    return max(device.minAvailableVideoZoomFactor, CGFloat(truncating: cambio))
+  }
