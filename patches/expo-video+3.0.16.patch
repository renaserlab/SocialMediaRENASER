+package expo.modules.video
+
+import android.content.Context
+import android.net.Uri
+import android.util.Log
+import androidx.annotation.OptIn
+import androidx.media3.common.C
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.datasource.DataSpec
+import expo.modules.kotlin.Promise
+import expo.modules.video.records.VideoSource
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.ExecutorService
+import java.util.concurrent.Executors
+import java.util.concurrent.Future
+import java.util.concurrent.atomic.AtomicBoolean
+
+/**
+ * Precarga NATIVA del inicio de un video en la MISMA cache de disco que lee el
+ * reproductor (parche de la app Zeta sobre expo-video, ver
+ * `patches/expo-video+3.0.16.patch`).
+ *
+ * POR QUE AQUI DENTRO. La cache de expo-video (`VideoManager.cache.instance`,
+ * un `SimpleCache`) solo la llena el `CacheDataSource` del reproductor: un
+ * fetch desde JS no la toca. Aqui se abre ese mismo `CacheDataSource`, armado
+ * con la misma funcion que usa el reproductor (`buildCacheDataSourceFactory`),
+ * y se lee el rango 0..bytes. Al leerlo, el propio `CacheDataSource` va
+ * escribiendo en el `SimpleCache` con la clave por defecto
+ * (`CacheKeyFactory.DEFAULT` = `uri.toString()`), que es la misma que usa el
+ * reproductor porque `VideoSource.toMediaItem` no pone `customCacheKey`.
+ *
+ * POR QUE NO `CacheWriter`. Si el pedido acotado falla al abrir, `CacheWriter`
+ * reintenta SIN limite de longitud y podria bajarse el video entero. Leer a
+ * mano con el `DataSpec` acotado garantiza que nunca se pide mas de `bytes`.
+ * Lo que ya esta en cache se lee de disco sin tocar la red.
+ *
+ * UN SOLO HILO, de prioridad baja: los pedidos se atienden en el orden en que
+ * llegan (el JS manda primero el mas cercano) y nunca hay dos precargas
+ * peleandose el ancho de banda con el video que se esta viendo.
+ *
+ * Si el reproductor esta escribiendo el mismo tramo, `SimpleCache` no presta
+ * el candado (el `CacheDataSource` va sin `FLAG_BLOCK_ON_CACHE`) y la lectura
+ * va directo a la red sin escribir: se gasta, pero no se rompe nada.
+ */
+@OptIn(UnstableApi::class)
+object PrecargadorDeVideos {
+  private const val TAG = "ExpoVideoPrecarga"
+  private const val TAMANO_DE_LECTURA = 64 * 1024
+
+  private val ejecutor: ExecutorService = Executors.newSingleThreadExecutor { tarea ->
+    Thread(tarea, TAG).apply {
+      isDaemon = true
+      priority = Thread.MIN_PRIORITY
+    }
+  }
+
+  private class Trabajo(private val promise: Promise) {
+    @Volatile
+    var cancelado = false
+    var futuro: Future<*>? = null
+    private val resuelto = AtomicBoolean(false)
+
+    fun terminar(listo: Boolean) {
+      if (resuelto.compareAndSet(false, true)) {
+        promise.resolve(listo)
+      }
+    }
+
+    fun cancelar() {
+      cancelado = true
+      // Sin interrumpir el hilo: se corta en el siguiente bloque leido. Si aun no
+      // empezo, ni arranca.
+      futuro?.cancel(false)
+      terminar(false)
+    }
+  }
+
+  private val trabajos = ConcurrentHashMap<String, Trabajo>()
+
+  /** Resuelve `true` si el tramo quedo en cache; `false` si se cancelo o fallo. Nunca rechaza. */
+  fun precargar(context: Context, uri: Uri, bytes: Long, promise: Promise) {
+    val clave = uri.toString()
+    if (bytes <= 0 || uri.scheme?.startsWith("http") != true) {
+      promise.resolve(false)
+      return
+    }
+    val trabajo = Trabajo(promise)
+    trabajos.put(clave, trabajo)?.cancelar()
+    try {
+      trabajo.futuro = ejecutor.submit {
+        var listo = false
+        try {
+          if (!trabajo.cancelado) {
+            listo = leerInicio(context, uri, bytes, trabajo)
+          }
+        } catch (e: Throwable) {
+          Log.w(TAG, "No se pudo precargar el video", e)
+        } finally {
+          trabajos.remove(clave, trabajo)
+          trabajo.terminar(listo)
+        }
+      }
+    } catch (e: Throwable) {
+      trabajos.remove(clave, trabajo)
+      trabajo.terminar(false)
+    }
+  }
+
+  fun cancelar(clave: String) {
+    trabajos.remove(clave)?.cancelar()
+  }
+
+  fun cancelarTodas() {
+    for (clave in trabajos.keys.toList()) {
+      cancelar(clave)
+    }
+  }
+
+  private fun leerInicio(context: Context, uri: Uri, bytes: Long, trabajo: Trabajo): Boolean {
+    // La misma fuente que arma el reproductor para `{ uri, useCaching: true }`:
+    // mismo SimpleCache, mismas banderas, mismo OkHttp y mismo User-Agent.
+    val fuente = VideoSource(uri = uri, useCaching = true)
+    val dataSource = buildCacheDataSourceFactory(context, fuente).createDataSource()
+    val dataSpec = DataSpec.Builder()
+      .setUri(uri)
+      .setPosition(0)
+      .setLength(bytes)
+      .build()
+    val bufer = ByteArray(TAMANO_DE_LECTURA)
+    var leidos = 0L
+    try {
+      dataSource.open(dataSpec)
+      while (!trabajo.cancelado && leidos < bytes) {
+        val pedidos = minOf(bufer.size.toLong(), bytes - leidos).toInt()
+        val n = dataSource.read(bufer, 0, pedidos)
+        if (n == C.RESULT_END_OF_INPUT) {
+          // Video mas corto que `bytes`: quedo entero en cache.
+          return true
+        }
+        leidos += n
+      }
+    } finally {
+      // Cerrar es lo que confirma en el SimpleCache el tramo escrito.
+      try {
+        dataSource.close()
+      } catch (e: Throwable) {
+        Log.w(TAG, "Error al cerrar la precarga", e)
+      }
+    }
+    return !trabajo.cancelado && leidos >= bytes
+  }
+}
