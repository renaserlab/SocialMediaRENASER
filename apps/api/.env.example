# === RENASER backend (apps/api) ===
# Copia este archivo a .env y complétalo. .env NUNCA se sube a git.

APP_NAME=RENASER Social Media API
ENVIRONMENT=development

# --- Base de datos: Supabase PostgreSQL (unica fuente de verdad) ---
# Supabase > Project Settings > Database > Connection string (URI).
# Cambia el esquema a postgresql+asyncpg y usa el pooler si aplica.
# Ejemplo:
# DATABASE_URL=postgresql+asyncpg://postgres:TU_PASSWORD@db.TUREF.supabase.co:5432/postgres
# En desarrollo sin Supabase se usa SQLite por defecto (no hace falta definirlo).
DATABASE_URL=sqlite+aiosqlite:///./renaser_dev.db

# --- Supabase ---
SUPABASE_URL=https://TUREF.supabase.co
# Clave publica (puede ir tambien en la app movil).
SUPABASE_ANON_KEY=
# SECRETO: solo backend. Da acceso saltandose RLS. NUNCA en la app ni en git.
# NECESARIA para borrar los archivos de Storage al eliminar una cuenta.
# Sin ella la cuenta se borra igual, pero las fotos, videos y audios quedan
# huerfanos en los buckets y la politica de privacidad dejaria de ser cierta.
# Da acceso total: solo aqui, nunca en la app movil ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# --- Validacion de JWT de Supabase Auth ---
# Supabase > Project Settings > API > JWT Settings > "JWT Secret" (HS256).
# NO es la anon key ni la service_role key.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated
# Opcional: https://TUREF.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=

# --- CORS ---
# Origenes de navegador autorizados, separados por comas.
#
# OBLIGATORIO EN PRODUCCION SI SE USA LA WEB. Con ENVIRONMENT=production el
# comodin "*" NO se acepta (dejaria que cualquier web llamara a la API desde el
# navegador de alguien con la sesion abierta), y sin origenes declarados se
# deniegan todos: la web deja de cargar con un error de CORS.
#
# La app movil no depende de esto: CORS lo aplican los navegadores.
#
# Ejemplo para produccion:
#   CORS_ORIGINS=https://social-media-renaser.vercel.app,https://renaser.com
# Sin barra al final y con el esquema (https://): el origen debe coincidir
# caracter por caracter con el del navegador.
CORS_ORIGINS=*

# --- Recomendaciones ---
# Personalizacion: cuestionario de intereses, "Personas para ti" y el orden de
# "Para ti". Encendida por defecto.
#
# Ponerla a false es el PLAN DE VUELTA ATRAS de esta funcionalidad: la
# aplicacion vuelve al feed cronologico y deja de preguntar, sin borrar una sola
# fila. Los endpoints siguen respondiendo (vacio y en silencio); devolver un
# error convertiria un apagado controlado en una pantalla rota.
FEATURE_RECOMMENDATIONS_V1=true

# --- Pagos ---
# Interruptor GENERAL. Apagado por defecto: con esto en false los endpoints de
# pago responden 503 en vez de simular un cobro.
PAYMENTS_ENABLED=false

# A donde vuelve quien paga, y a donde vuelve quien cancela. Distintas a
# proposito: mandar a la pagina de "gracias por tu compra" a quien acaba de
# cancelar es mentirle sobre lo que ha pasado.
PAYMENTS_RETURN_URL=https://social-media-renaser.vercel.app/pago
PAYMENTS_CANCEL_URL=https://social-media-renaser.vercel.app/pago/cancelado

# --- Pagos: movil (RevenueCat) ---
# Verificacion servidor a servidor de las compras de las tiendas. Apagada por
# defecto. Mientras este en false, POST /payments/native/sync responde 503 y NO
# concede nada: un "exito" del cliente jamas basta.
REVENUECAT_VERIFICATION_ENABLED=false

# Webhook de RevenueCat. Bandera propia y aparte porque todavia no sabemos si
# vamos a tener webhooks. Las devoluciones NO dependen de el: la
# reconciliacion de native/sync ya revoca por su cuenta, porque RevenueCat
# conserva la compra devuelta con status "refunded" y eso se puede consultar.
REVENUECAT_WEBHOOK_ENABLED=false

# SECRETOS. Solo backend, NUNCA con prefijo EXPO_PUBLIC_: con la clave secreta
# se conceden entitlements y se borran subscriptores de todo el proyecto.
# La secreta empieza por "sk_" (Project Settings -> API keys -> Secret).
REVENUECAT_SECRET_API_KEY=
# Identificador del proyecto en RevenueCat, tipo "proj1ab2c3d4". La API v2 va
# siempre acotada a un proyecto.
REVENUECAT_PROJECT_ID=
# Secreto compartido que se declara al dar de alta el webhook, si se llega a
# usar. Sin el, el webhook no se acepta.
REVENUECAT_WEBHOOK_SECRET=

# --- Eventos: entradas y cobro ---
# Los tipos de entrada, la disponibilidad y las reservas temporales. Apagada,
# esas rutas responden 503 y el catalogo, la ficha y la reserva gratuita siguen
# funcionando exactamente igual.
FEATURE_EVENT_TICKETING=false
# COBRAR una entrada. Separada de la anterior a proposito: apagarla detiene la
# venta y deja intacto el inventario. Apagada NO para el dinero ya en curso: un
# webhook verificado de una orden iniciada antes se sigue atendiendo.
FEATURE_EVENT_PAYMENTS=false
# Que pasarela cobra las entradas: "none" o "stripe". Con "none" no se puede
# iniciar un pago, y decirlo es mas honesto que fallar al llamar.
EVENT_PAYMENTS_PROVIDER=none

# --- Pagos: web (Stripe) ---
# Stripe es SOLO WEB. En movil se compra con las tiendas; meter Stripe en el
# flujo nativo de compra de cursos es motivo de rechazo en Apple y en Google.
STRIPE_PAYMENTS_ENABLED=false
# Clave secreta de la cuenta. En pruebas empieza por "sk_test_".
STRIPE_SECRET_KEY=
# Secreto del endpoint de webhook, "whsec_...". Sin el no se puede verificar la
# firma, y sin verificar la firma cualquiera que descubra la URL se regala el
# catalogo entero.
STRIPE_WEBHOOK_SECRET=
# Base de la API de Stripe. Se deja configurable para poder apuntarla a un doble
# en pruebas de integracion sin tocar codigo. En produccion NO se cambia.
STRIPE_API_BASE=https://api.stripe.com
# NO HAY CLAVE PUBLICA. Se usa Checkout ALOJADO: la sesion se crea desde el
# servidor y se manda a la persona a la URL que Stripe devuelve. Un formulario
# de tarjeta propio arrastraria el cumplimiento PCI entero.
# La URL que hay que registrar en el panel de Stripe y los eventos que hay que
# marcar estan en docs/Z_STRIPE_PUESTA_EN_MARCHA.md.

# --- Devoluciones y disputas ---
# La garantia y las solicitudes de devolucion de CURSOS. Apagado, no arrancan
# garantias nuevas ni se aceptan solicitudes; lo ya concedido sigue.
FEATURE_COURSE_REFUNDS=false
# EJECUTAR la devolucion contra la pasarela. Separada a proposito: con la
# anterior encendida y esta apagada, todo el circuito interno —solicitar,
# revisar, aprobar— se prueba de punta a punta sin que salga un euro. Apagada,
# el adaptador falla EN CERRADO: nunca simula un reembolso con exito.
STRIPE_REFUNDS_ENABLED=false
# Los avisos de DISPUTA no dependen de ninguna bandera: un contracargo se
# registra y congela el saldo aunque las ventas esten apagadas, porque no
# anotarlo seria la unica forma segura de perder ese dinero.

# --- Liquidacion a quien vende ---
# Cuentas conectadas de Stripe (Connect). APAGADO. No existe alta de cuenta.
STRIPE_CONNECT_ENABLED=false
# TRANSFERIR de verdad. APAGADO, y ademas exige la comision configurada: sin
# ella no hay neto que transferir.
CREATOR_TRANSFERS_ENABLED=false
# Comision de la plataforma, en PUNTOS BASICOS (100 = 1 %).
#
# -1 SIGNIFICA SIN CONFIGURAR, y es el valor de fabrica. NO ES CERO: con cero,
# olvidarse de ponerla haria que Z se quedara con nada y transfiriera el bruto,
# y ese error no lo delata ninguna prueba porque el resultado cuadra. Con -1 no
# se escribe ni un saldo y las transferencias quedan bloqueadas hasta que
# alguien decida el numero, que es una decision de la empresa.
PLATFORM_FEE_BPS=-1
# Version de las reglas de comision. Se guarda en CADA venta para que cambiarlas
# manana no reescriba lo ya liquidado.
FEE_RULES_VERSION=v1
# LA MONEDA NO SE CONFIGURA AQUI. Sale de la politica publicada para cada
# jurisdiccion y viaja congelada en el pedido. Una moneda global seria decidir
# en que cobra un pais que todavia no se ha abierto.

# --- Productos fisicos ---
# MIRAR el catalogo: portada, busqueda, categorias y ficha. Encendida no
# habilita comprar nada, y sin migraciones aplicadas la portada contesta
# "disponible: false" sola.
FEATURE_PRODUCTS=true
# VENDER un producto fisico. APAGADA. Encenderla sola no basta: hacen falta
# PAYMENTS_ENABLED, STRIPE_PAYMENTS_ENABLED, STRIPE_SECRET_KEY y
# PRODUCT_RESERVATION_MINUTES, y la ruta dice cual falta en vez de fallar
# dentro del SDK de la pasarela.
FEATURE_PRODUCT_SALES=false
# CUANTOS MINUTOS aparta un pedido su inventario antes de vencer.
#
# CERO SIGNIFICA SIN CONFIGURAR, y sin configurar no se vende. No hay numero de
# fabrica a proposito: cuanto tiempo se le guarda a alguien la ultima unidad
# mientras paga afecta a cuantas ventas se pierden y a cuanto stock queda
# congelado, y escribir aqui un numero seria tomar esa decision en nombre de la
# empresa, en silencio y para siempre. El rango admitido es 1..1440.
PRODUCT_RESERVATION_MINUTES=0

# --- Z Servicios (admision de prestadores) ---
# APAGADA. Apagada, cada ruta de Servicios contesta 503 "services_disabled" sin
# mirar la base y la app no ensena ninguna entrada. Encendida sin las
# migraciones 0086-0088 aplicadas, 503 "services_not_ready" (nunca un 500).
# NO enciende pagos, reservas ni nada de Eventos o Productos. No encender en
# produccion antes de resolver el borrado de cuenta frente a audit_events
# (docs/Z_SERVICIOS_ARQUITECTURA.md, seccion 12).
FEATURE_SERVICES=false
# EL PILOTO de Servicios (politica P101). Con FEATURE_SERVICES encendida NO se
# abre a todo el mundo: solo a estos perfiles (UUID separados por comas, sin
# espacios). VACIA = NO ENTRA NADIE, y una lista mal escrita tampoco deja
# entrar a nadie. A quien no entra se le contesta 503 "services_disabled",
# tambien sin sesion y tambien en el catalogo publico. Administracion entra por
# su rol; estar en la lista no da ninguno.
SERVICES_PILOT_PROFILE_IDS=
# La APERTURA GENERAL. Solo con "true" deja de mirarse la lista del piloto: no
# se deduce de una lista vacia.
SERVICES_PUBLIC_ACCESS=false
# Catalogo de Servicios (Incremento 2). Las modalidades y la moneda son la
# politica de la primera version (02/10/2026): en linea y en el local del
# prestador, en soles. "at_home" sigue en el modelo, pero lo que no este aqui
# no entra en un borrador (422) ni se filtra.
SERVICES_CATALOG_MODALITIES=virtual,in_person
SERVICES_CATALOG_PRICE_MODELS=free,fixed,from,on_request
SERVICES_CATALOG_CURRENCIES=PEN
SERVICES_CATALOG_MIN_DURATION_MINUTES=5
SERVICES_CATALOG_MAX_DURATION_MINUTES=1440
SERVICES_CATALOG_MAX_IMAGES=8
# Contratacion de Servicios (Incremento 5). APAGADA. Exige la 0093 aplicada y
# la API reiniciada; sin ella, 503 "services_not_ready". Apagada, se ven los
# horarios pero no se aparta ni se reserva nada (503
# "service_booking_disabled"). Solo se contrata lo GRATUITO.
FEATURE_SERVICE_BOOKING=false
# El cobro de un servicio. NO EXISTE adaptador de pago para Servicios: aunque se
# encendiera, un servicio con precio sigue contestando 503
# "service_booking_payments_not_configured". No encender.
FEATURE_SERVICE_PAYMENTS=false
SERVICE_PAYMENTS_PROVIDER=none
# PROVISIONALES (decisiones F1 y F2 de docs/Z_REQUISITOS_Y_DECISIONES.md):
# minutos que aparta una retencion y cuantas activas puede tener una persona.
SERVICES_BOOKING_HOLD_MINUTES=10
SERVICES_BOOKING_MAX_ACTIVE_HOLDS=3
# Modalidades que se confirman solas. A domicilio no: la acepta el prestador y
# esa aceptacion todavia no existe (409).
SERVICES_BOOKING_INSTANT_MODALITIES=virtual,in_person
# La atencion y la posventa (Incremento 6). TODO PROVISIONAL: son valores de
# trabajo, no decisiones de la empresa (serie G de
# docs/Z_REQUISITOS_Y_DECISIONES.md). No hay bandera propia: van con
# FEATURE_SERVICE_BOOKING y exigen la migracion 0094.
# Minutos antes de la hora en que se abre la llegada, y tolerancia para
# reportar una inasistencia.
SERVICES_ATTENTION_CHECKIN_MINUTES=15
SERVICES_ATTENTION_TOLERANCE_MINUTES=15
# Horas que tiene quien contrata para confirmar que la atencion se realizo.
SERVICES_ATTENTION_CONFIRMATION_HOURS=24
# Cuantas veces reprograma quien contrata y con cuantas horas de antelacion;
# con cuantas horas de antelacion se recuerda una reserva.
SERVICES_BOOKING_RESCHEDULE_MAX=1
SERVICES_BOOKING_RESCHEDULE_MIN_HOURS=24
SERVICES_BOOKING_REMINDER_HOURS=24
# Horas para abrir un caso tras la atencion y dias para apelar su resolucion.
SERVICES_INCIDENT_WINDOW_HOURS=48
SERVICES_INCIDENT_APPEAL_DAYS=5
# Cuantas veces se apela un caso: 0 (ninguna) o 1. Con una sola persona en
# administracion la apelacion no se ofrece: la resuelve otra persona.
SERVICES_INCIDENT_APPEALS_MAX=1
# Dias para resenar y si una resena espera a moderacion antes de publicarse.
SERVICES_REVIEW_WINDOW_DAYS=30
SERVICES_REVIEWS_PREMODERATION=true

# --- Beta gratuita ---
# Conceder GRATIS un curso de pago a quien lo pide. APAGADO. Es una palanca de
# dinero aunque el importe sea cero: encendida, el catalogo de pago se regala.
BETA_FREE_ACCESS_ENABLED=false

# --- Transmisiones en vivo (100ms) ---
# Interruptor general del video. Apagado, el modulo de directos sigue entero
# —sala, chat, reacciones, moderacion— y lo unico que falta es la imagen.
FEATURE_LIVE=false
# Quien sirve el video: "none" (marcador de posicion que falla en cerrado) o
# "100ms". Amazon IVS es alternativa futura y NO esta implementada.
LIVE_PROVIDER=none
# Credenciales de la cuenta de 100ms. SOLO BACKEND: la clave secreta firma los
# tokens de sala, asi que meterla en la aplicacion seria repartir la llave con
# la que cualquiera se declara anfitrion de la emision de otro. NUNCA en
# EXPO_PUBLIC_*.
HMS_APP_ACCESS_KEY=
HMS_APP_SECRET=
# La plantilla decide roles, calidad y grabacion. Sin ella no se crea sala.
HMS_TEMPLATE_ID=
# Lo que se declara como cabecera de autorizacion al dar de alta el webhook en
# el panel de 100ms. Sin el, no se acepta ningun aviso.
HMS_WEBHOOK_SECRET=
# Region de la cuenta, si la cuenta la fija. Vacio = la que elija 100ms.
HMS_REGION=
# Cuanto dura la credencial de sala, en segundos.
LIVE_CREDENTIAL_TTL_SECONDS=3600
# Techo de emisiones simultaneas y duracion maxima. Existen para que un fallo o
# un abuso no se traduzca en una factura: cada sala viva cuesta minutos.
LIVE_MAX_CONCURRENT=3
LIVE_MAX_DURATION_MINUTES=180

# --------------------------------------------------------------------------- #
# Contexto de origen de los consentimientos y la auditoria
# --------------------------------------------------------------------------- #
# La sal con la que se calcula la huella de la IP (HMAC-SHA256). NO SE GUARDA
# NINGUNA IP EN CLARO: lo unico que se escribe es esa huella y el prefijo de red
# (/24 en IPv4, /48 en IPv6), que agrupa sin identificar.
#
# HACEN FALTA 32 CARACTERES COMO MINIMO. Por debajo se trata como si no hubiera
# sal: se avisa por registro y la huella queda en NULL. El motivo es que IPv4
# entero son 2^32 direcciones y se recorre en minutos, asi que una sal corta se
# adivina junto con la direccion y la huella deja de proteger nada. Vacia,
# tambien queda en NULL: mejor una columna vacia que un dato que aparenta
# proteccion y no la da.
#
# NO SE COMPARTE ENTRE ENTORNOS. Con la misma sal en pruebas y en produccion,
# una huella de un sitio identifica a la misma persona en el otro.
# CAMBIARLA INVALIDA LAS HUELLAS YA GUARDADAS: dejan de poder compararse con las
# nuevas. Es una rotacion consciente, no una operacion rutinaria.
IP_HASH_SALT=
# Si hay un proxy de confianza delante que escribe `X-Forwarded-For`.
#
# EN false —el valor por defecto— LA CABECERA SE IGNORA ENTERA y se usa la
# direccion del socket. Esa cabecera la manda cualquiera: activarla sin un proxy
# que la reescriba deja que quien pide elija que origen se le apunta a su
# consentimiento. Se pone en true SOLO cuando todo el trafico entra por un proxy
# propio.
TRUST_PROXY_HEADERS=false
