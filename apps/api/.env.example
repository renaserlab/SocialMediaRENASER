# === RENASER backend (apps/api) ===
# Copia este archivo a .env y complétalo. .env NUNCA se sube a git.

APP_NAME=RENASER Social Media API
ENVIRONMENT=development

# --- Base de datos: Supabase PostgreSQL (unica fuente de verdad) ---
# Supabase > Project Settings > Database > Connection string (URI).
# Cambia el esquema a postgresql+asyncpg y usa el pooler si aplica.
# Ejemplo:
# DATABASE_URL=postgresql+asyncpg://postgres:TU_PASSWORD@db.TUREF.supabase.co:5432/postgres
# En desarrollo sin Supabase se usa SQLite por defecto (no hace falta definirlo).
DATABASE_URL=sqlite+aiosqlite:///./renaser_dev.db

# --- Supabase ---
SUPABASE_URL=https://TUREF.supabase.co
# Clave publica (puede ir tambien en la app movil).
SUPABASE_ANON_KEY=
# SECRETO: solo backend. Da acceso saltandose RLS. NUNCA en la app ni en git.
# NECESARIA para borrar los archivos de Storage al eliminar una cuenta.
# Sin ella la cuenta se borra igual, pero las fotos, videos y audios quedan
# huerfanos en los buckets y la politica de privacidad dejaria de ser cierta.
# Da acceso total: solo aqui, nunca en la app movil ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# --- Validacion de JWT de Supabase Auth ---
# Supabase > Project Settings > API > JWT Settings > "JWT Secret" (HS256).
# NO es la anon key ni la service_role key.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated
# Opcional: https://TUREF.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=

# --- CORS ---
# Origenes de navegador autorizados, separados por comas.
#
# OBLIGATORIO EN PRODUCCION SI SE USA LA WEB. Con ENVIRONMENT=production el
# comodin "*" NO se acepta (dejaria que cualquier web llamara a la API desde el
# navegador de alguien con la sesion abierta), y sin origenes declarados se
# deniegan todos: la web deja de cargar con un error de CORS.
#
# La app movil no depende de esto: CORS lo aplican los navegadores.
#
# Ejemplo para produccion:
#   CORS_ORIGINS=https://social-media-renaser.vercel.app,https://renaser.com
# Sin barra al final y con el esquema (https://): el origen debe coincidir
# caracter por caracter con el del navegador.
CORS_ORIGINS=*

# --- Recomendaciones ---
# Personalizacion: cuestionario de intereses, "Personas para ti" y el orden de
# "Para ti". Encendida por defecto.
#
# Ponerla a false es el PLAN DE VUELTA ATRAS de esta funcionalidad: la
# aplicacion vuelve al feed cronologico y deja de preguntar, sin borrar una sola
# fila. Los endpoints siguen respondiendo (vacio y en silencio); devolver un
# error convertiria un apagado controlado en una pantalla rota.
FEATURE_RECOMMENDATIONS_V1=true

# --- Pagos ---
# Interruptor GENERAL. Apagado por defecto: con esto en false los endpoints de
# pago responden 503 en vez de simular un cobro.
PAYMENTS_ENABLED=false

# A donde vuelve quien paga, y a donde vuelve quien cancela. Distintas a
# proposito: mandar a la pagina de "gracias por tu compra" a quien acaba de
# cancelar es mentirle sobre lo que ha pasado.
PAYMENTS_RETURN_URL=https://social-media-renaser.vercel.app/pago
PAYMENTS_CANCEL_URL=https://social-media-renaser.vercel.app/pago/cancelado

# --- Pagos: movil (RevenueCat) ---
# Verificacion servidor a servidor de las compras de las tiendas. Apagada por
# defecto. Mientras este en false, POST /payments/native/sync responde 503 y NO
# concede nada: un "exito" del cliente jamas basta.
REVENUECAT_VERIFICATION_ENABLED=false

# Webhook de RevenueCat. Bandera propia y aparte porque todavia no sabemos si
# vamos a tener webhooks. Las devoluciones NO dependen de el: la
# reconciliacion de native/sync ya revoca por su cuenta, porque RevenueCat
# conserva la compra devuelta con status "refunded" y eso se puede consultar.
REVENUECAT_WEBHOOK_ENABLED=false

# SECRETOS. Solo backend, NUNCA con prefijo EXPO_PUBLIC_: con la clave secreta
# se conceden entitlements y se borran subscriptores de todo el proyecto.
# La secreta empieza por "sk_" (Project Settings -> API keys -> Secret).
REVENUECAT_SECRET_API_KEY=
# Identificador del proyecto en RevenueCat, tipo "proj1ab2c3d4". La API v2 va
# siempre acotada a un proyecto.
REVENUECAT_PROJECT_ID=
# Secreto compartido que se declara al dar de alta el webhook, si se llega a
# usar. Sin el, el webhook no se acepta.
REVENUECAT_WEBHOOK_SECRET=

# --- Pagos: web (Stripe) ---
# Stripe es SOLO WEB. En movil se compra con las tiendas; meter Stripe en el
# flujo nativo de compra de cursos es motivo de rechazo en Apple y en Google.
STRIPE_PAYMENTS_ENABLED=false
# Clave secreta de la cuenta. En pruebas empieza por "sk_test_".
STRIPE_SECRET_KEY=
# Secreto del endpoint de webhook, "whsec_...". Sin el no se puede verificar la
# firma, y sin verificar la firma cualquiera que descubra la URL se regala el
# catalogo entero.
STRIPE_WEBHOOK_SECRET=

# --- Transmisiones en vivo (100ms) ---
# Interruptor general del video. Apagado, el modulo de directos sigue entero
# —sala, chat, reacciones, moderacion— y lo unico que falta es la imagen.
FEATURE_LIVE=false
# Quien sirve el video: "none" (marcador de posicion que falla en cerrado) o
# "100ms". Amazon IVS es alternativa futura y NO esta implementada.
LIVE_PROVIDER=none
# Credenciales de la cuenta de 100ms. SOLO BACKEND: la clave secreta firma los
# tokens de sala, asi que meterla en la aplicacion seria repartir la llave con
# la que cualquiera se declara anfitrion de la emision de otro. NUNCA en
# EXPO_PUBLIC_*.
HMS_APP_ACCESS_KEY=
HMS_APP_SECRET=
# La plantilla decide roles, calidad y grabacion. Sin ella no se crea sala.
HMS_TEMPLATE_ID=
# Lo que se declara como cabecera de autorizacion al dar de alta el webhook en
# el panel de 100ms. Sin el, no se acepta ningun aviso.
HMS_WEBHOOK_SECRET=
# Region de la cuenta, si la cuenta la fija. Vacio = la que elija 100ms.
HMS_REGION=
# Cuanto dura la credencial de sala, en segundos.
LIVE_CREDENTIAL_TTL_SECONDS=3600
# Techo de emisiones simultaneas y duracion maxima. Existen para que un fallo o
# un abuso no se traduzca en una factura: cada sala viva cuesta minutos.
LIVE_MAX_CONCURRENT=3
LIVE_MAX_DURATION_MINUTES=180

# --------------------------------------------------------------------------- #
# Contexto de origen de los consentimientos y la auditoria
# --------------------------------------------------------------------------- #
# La sal con la que se calcula la huella de la IP (HMAC-SHA256). NO SE GUARDA
# NINGUNA IP EN CLARO: lo unico que se escribe es esa huella y el prefijo de red
# (/24 en IPv4, /48 en IPv6), que agrupa sin identificar.
#
# HACEN FALTA 32 CARACTERES COMO MINIMO. Por debajo se trata como si no hubiera
# sal: se avisa por registro y la huella queda en NULL. El motivo es que IPv4
# entero son 2^32 direcciones y se recorre en minutos, asi que una sal corta se
# adivina junto con la direccion y la huella deja de proteger nada. Vacia,
# tambien queda en NULL: mejor una columna vacia que un dato que aparenta
# proteccion y no la da.
#
# NO SE COMPARTE ENTRE ENTORNOS. Con la misma sal en pruebas y en produccion,
# una huella de un sitio identifica a la misma persona en el otro.
# CAMBIARLA INVALIDA LAS HUELLAS YA GUARDADAS: dejan de poder compararse con las
# nuevas. Es una rotacion consciente, no una operacion rutinaria.
IP_HASH_SALT=
# Si hay un proxy de confianza delante que escribe `X-Forwarded-For`.
#
# EN false —el valor por defecto— LA CABECERA SE IGNORA ENTERA y se usa la
# direccion del socket. Esa cabecera la manda cualquiera: activarla sin un proxy
# que la reescriba deja que quien pide elija que origen se le apunta a su
# consentimiento. Se pone en true SOLO cuando todo el trafico entra por un proxy
# propio.
TRUST_PROXY_HEADERS=false
