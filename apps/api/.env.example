# === RENASER backend (apps/api) ===
# Copia este archivo a .env y complétalo. .env NUNCA se sube a git.

APP_NAME=RENASER Social Media API
ENVIRONMENT=development

# --- Base de datos: Supabase PostgreSQL (unica fuente de verdad) ---
# Supabase > Project Settings > Database > Connection string (URI).
# Cambia el esquema a postgresql+asyncpg y usa el pooler si aplica.
# Ejemplo:
# DATABASE_URL=postgresql+asyncpg://postgres:TU_PASSWORD@db.TUREF.supabase.co:5432/postgres
# En desarrollo sin Supabase se usa SQLite por defecto (no hace falta definirlo).
DATABASE_URL=sqlite+aiosqlite:///./renaser_dev.db

# --- Supabase ---
SUPABASE_URL=https://TUREF.supabase.co
# Clave publica (puede ir tambien en la app movil).
SUPABASE_ANON_KEY=
# SECRETO: solo backend. Da acceso saltandose RLS. NUNCA en la app ni en git.
# NECESARIA para borrar los archivos de Storage al eliminar una cuenta.
# Sin ella la cuenta se borra igual, pero las fotos, videos y audios quedan
# huerfanos en los buckets y la politica de privacidad dejaria de ser cierta.
# Da acceso total: solo aqui, nunca en la app movil ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# --- Validacion de JWT de Supabase Auth ---
# Supabase > Project Settings > API > JWT Settings > "JWT Secret" (HS256).
# NO es la anon key ni la service_role key.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated
# Opcional: https://TUREF.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=

# --- CORS ---
# En produccion restringe a los origenes reales (coma-separado), no "*".
CORS_ORIGINS=*
