EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Tamano maximo por archivo subido, en MB. Debe coincidir con el limite del
# proyecto Supabase (Storage -> Settings) y del bucket post-media.
EXPO_PUBLIC_MAX_UPLOAD_MB=500

# --- Compras (RevenueCat) ---
# Modo de compra: off | test | stores.  POR DEFECTO off.
#   off    -> no se vende nada. La pantalla de curso lo dice con palabras.
#   test   -> RevenueCat Test Store. Es lo que se usa en desarrollo: compras de
#             verdad contra el SDK de verdad, sin App Store ni Google Play.
#   stores -> Google Play y App Store reales.
# NO existe un modo "simulado" local, y no va a volver: la pantalla que lo hacia
# terminaba siempre en "transaccion rechazada" y su boton de reintentar
# regalaba el curso.
EXPO_PUBLIC_PURCHASES_MODE=off

# Claves PUBLICAS del SDK de RevenueCat. Son publicas de verdad: van dentro del
# paquete que se instala cualquiera. Las SECRETAS (sk_...) jamas se ponen aqui
# ni llevan el prefijo EXPO_PUBLIC_: viven solo en el backend.
#
# La del Test Store, para EXPO_PUBLIC_PURCHASES_MODE=test.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
# Las de tienda, para EXPO_PUBLIC_PURCHASES_MODE=stores.
# Android empieza por "goog_" y iOS por "appl_"; la validacion de
# services/comprasConfig.ts lo exige, y por eso una release no puede salir con
# la clave del Test Store puesta por error.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
