{
  "expo": {
    "name": "Z",
    "slug": "z-app",
    "version": "1.2.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "z",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/66fb7bea-7810-43c5-bf1d-58f6f50cb0ba"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.renaser.zeta",
      "infoPlist": {
        "NSCameraUsageDescription": "Z usa la cámara para que tomes fotos y grabes videos para publicar y para tus historias, y para transmitir en vivo.",
        "NSPhotoLibraryUsageDescription": "Z accede a tus fotos cuando eliges contenido para publicar o cambias tu foto de perfil.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Z usa el micrófono para grabar el sonido de los videos de tus historias y para transmitir en vivo.",
        "NSLocalNetworkUsageDescription": "Z usa la red local para conectar las transmisiones en vivo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.renaser.zeta",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CHANGE_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Z accede a tus fotos cuando eliges contenido para publicar o cambias tu foto de perfil.",
          "cameraPermission": "Z usa la cámara para que tomes fotos y grabes videos para publicar y para tus historias, y para transmitir en vivo."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Z usa la cámara para que puedas tomar fotos y grabar videos para tus historias, y para transmitir en vivo.",
          "microphonePermission": "Z usa el micrófono para grabar el sonido de los videos de tus historias y para transmitir en vivo.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#000000",
          "sounds": [
            "./assets/sonidos/mensaje_enviado.wav",
            "./assets/sonidos/mensaje_recibido.wav",
            "./assets/sonidos/alguien_escribe.wav"
          ]
        }
      ],
      "./plugins/withColoresDelRecorte",
      "expo-font",
      "expo-video",
      "react-native-compressor",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "Z accede a tus fotos para que elijas cuál compartir en tu historia.",
          "savePhotosPermission": "Z guarda en tu galería las fotos y videos que capturas.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          },
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "./app"
      },
      "eas": {
        "projectId": "66fb7bea-7810-43c5-bf1d-58f6f50cb0ba"
      }
    },
    "owner": "renaser-lab"
  }
}
