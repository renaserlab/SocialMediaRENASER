    "mobile:check": "npm --workspace apps/mobile run check",
    "mobile:test": "npm --workspace apps/mobile run test",
    "build:web": "npm --workspace apps/mobile run build:web"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react": "~19.1.10",
    "react-native": "0.81.5",
    "react-native-worklets": "0.5.1"
  }
}
