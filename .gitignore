# IDE / tooling
.gemini/
.idea/

# npm workspaces: only the root lockfile is tracked
apps/*/package-lock.json

# Bases de datos locales de desarrollo (SQLite)
*.db

# Datos reales de la empresa para las paginas legales (no versionar)
legal/datos.json
legal/publicar/

# Red de seguridad: el script de videos ya guarda sus copias FUERA del
# proyecto, pero si alguien apunta `RESPALDO_VIDEOS_DIR` aqui dentro, que no
# acaben en el repositorio. Son cientos de megas de contenido, no codigo.
respaldo_videos/
.vercel
.env*

# Volcado de la consola de arranque de una instancia EC2. Es un artefacto de
# diagnostico, no del proyecto: sin esta linea un `git add -A` se lo lleva.
ec2-arranque.txt

# Despliegue en AWS: la evidencia de cada ejecucion (lleva la cuenta y el
# operador) y cualquier fichero de secretos que alguien deje a mano aqui.
infra/aws/evidencias/
infra/aws/secretos*.json
!infra/aws/secretos.ejemplo.json

# Graphify: grafo local del codigo para Claude; se regenera con `graphify . --code-only`.
graphify-out/

# Carpeta de trabajo del Supabase local (scripts/supabase_local.sh): contenedores,
# migraciones copiadas y estado de la CLI. Se regenera sola.
.supabase-local/
